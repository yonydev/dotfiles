#!/bin/bash
# Daily check: are there installed packages the manifests don't know about?
# Sticky desktop notification listing them; the run result is logged to the
# journal either way. Run by dotfiles-manifest-check.timer.
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
out="$(make -s -C "$REPO" capture)"

if [[ $out == "manifest is up to date" ]]; then
  echo "manifest in sync"
  exit 0
fi

echo "manifest stale: $(wc -l <<<"$out") line(s) unrecorded"
echo "$out"

body="$out
(run 'make capture' in ~/dotfiles)"

# Critical urgency = notification stays until dismissed (a once-a-day
# actionable alert must not expire while unattended).
if command -v omarchy-notification-send >/dev/null; then
  omarchy-notification-send -u critical -g 󰏗 --app-name dotfiles \
    "Package manifest is stale" "$body"
else
  notify-send -u critical -a dotfiles -i software-update-available \
    "Package manifest is stale" "$body"
fi
