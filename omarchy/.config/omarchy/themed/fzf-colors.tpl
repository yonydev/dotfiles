# fzf options file generated from the active Omarchy theme palette (colors.toml).
# Rendered by omarchy-theme-set-templates into ~/.local/state/omarchy/current/theme/fzf-colors
# Loaded live on every fzf invocation via FZF_DEFAULT_OPTS_FILE
# (exported in ~/.bash-plugins/fzf-preview.sh), so theme switches apply to
# already-open terminals without re-sourcing .bashrc.
--color=fg:{{ foreground }},bg:{{ background }},hl:{{ accent }}
--color=fg+:{{ foreground }},bg+:{{ color0 }},hl+:{{ accent }}
--color=info:{{ color3 }},prompt:{{ accent }},pointer:{{ cursor }}
--color=marker:{{ cursor }},spinner:{{ color3 }},header:{{ color8 }}
--color=border:{{ color8 }}
